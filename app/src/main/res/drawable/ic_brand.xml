<?xml version="1.0" encoding="utf-8"?>
<!--
  A flattened copy of the launcher icon, usable as an ordinary Drawable.

  The launcher icon is an adaptive-icon XML, which composes a background and
  foreground layer. `painterResource` only accepts a VectorDrawable or a
  rasterised asset, so pointing it straight at R.mipmap.ic_launcher threw
  "Only VectorDrawables and rasterized asset types are supported" the moment
  the empty state was composed. This vector bakes the two layers together so
  the same artwork can be drawn in-app.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Background, a single dark rounded plate.
         The launcher icon draws this as white + #101014 in two separate paths to
         fake an adaptive-icon safe zone. Inside the app that white ring read as
         a border around the mark, so the plate is a single fill here. -->
    <path
        android:fillColor="#101014"
        android:pathData="M18,18h72v72h-72z" />

    <!-- Foreground: the four Prisma squares. -->
    <path
        android:fillColor="#EF476F"
        android:pathData="M28,22h19a6,6 0 0 1 6,6v19a6,6 0 0 1 -6,6h-19a6,6 0 0 1 -6,-6v-19a6,6 0 0 1 6,-6z" />
    <path
        android:fillColor="#FFD166"
        android:pathData="M61,22h19a6,6 0 0 1 6,6v19a6,6 0 0 1 -6,6h-19a6,6 0 0 1 -6,-6v-19a6,6 0 0 1 6,-6z" />
    <path
        android:fillColor="#06D6A0"
        android:pathData="M28,55h19a6,6 0 0 1 6,6v19a6,6 0 0 1 -6,6h-19a6,6 0 0 1 -6,-6v-19a6,6 0 0 1 6,-6z" />
    <path
        android:fillColor="#118AB2"
        android:pathData="M61,55h19a6,6 0 0 1 6,6v19a6,6 0 0 1 -6,6h-19a6,6 0 0 1 -6,-6v-19a6,6 0 0 1 6,-6z" />

    <!-- The "P" mark, identical path to the launcher foreground. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36.84,76L36.84,32L57.96,32A13.2,13.2 0 0 1 57.96,58.4L44.76,58.4L44.76,76ZM44.76,50.48L57.96,50.48A5.28,5.28 0 0 0 57.96,39.92L44.76,39.92Z" />
</vector>
