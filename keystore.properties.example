# Release signing configuration - TEMPLATE
#
# Copy this file to `keystore.properties` (same directory) and fill in the
# real values. `keystore.properties` is git-ignored; this template is tracked
# so the shape of the file is obvious to anyone who clones the repo.
#
#   copy keystore.properties.example keystore.properties
#
# The build reads keystore.properties and refuses to produce a release APK
# without it. There is deliberately no debug-key fallback: a debug-signed
# "release" APK installs and runs normally, so the mistake stays invisible
# until the app cannot be updated with the real key.

# Path to the keystore, relative to this file's directory.
storeFile=release.jks

# The keystore's own password (set when you created it with keytool).
storePassword=CHANGE_ME

# The alias for the signing key inside the keystore.
keyAlias=CHANGE_ME

# The password for that specific key. Often the same as storePassword, but
# keytool asks for them separately and they do not have to match.
keyPassword=CHANGE_ME


# ---------------------------------------------------------------------------
# Creating the keystore
# ---------------------------------------------------------------------------
#
#   keytool -genkeypair -v ^
#     -keystore release.jks ^
#     -keyalg RSA -keysize 4096 ^
#     -validity 10000 ^
#     -alias alex
#
# -validity is in days. 10000 is about 27 years; the app can never be
# updated after the key expires, so be generous.
#
# keytool will ask for a distinguished name (CN, O, L, ST, C). Only CN is
# meaningful for an Android app - the rest is convention.


# ---------------------------------------------------------------------------
# BACK THIS UP
# ---------------------------------------------------------------------------
#
# release.jks and the two passwords are the only thing standing between this
# project and the ability to ship an update. If they are lost:
#
#   * the app cannot be updated on Play or as an update - Android treats a
#     different signing key as a completely different app, and users would
#     have to uninstall and lose their saved projects
#   * there is no recovery path
#
# So: back up release.jks somewhere you will not lose it, keep the passwords
# in a password manager, and do not rely on this repository for either.